# Application Configuration
APP_ENV=development
APP_PORT=8080
BASE_URL=http://localhost:8080

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=taikai
DATABASE_USER=taikai
DATABASE_PASSWORD=taikai_dev_password
DATABASE_POOL_SIZE=25
DATABASE_URL=postgresql://taikai:taikai_dev_password@localhost:5432/taikai?sslmode=disable

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION=604800

# Email Configuration (Development - Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@taikai.local
SMTP_FROM_NAME=Taikai

# Email Configuration (Production - AWS SES)
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY=
# AWS_SES_SECRET_KEY=
# EMAIL_FROM=noreply@forgeutah.org

# SMS Configuration (Twilio - Phase 2)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# OAuth Configuration (Phase 2)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/github/callback

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Mailpit (Development Only)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
